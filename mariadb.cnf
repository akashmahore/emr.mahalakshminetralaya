# Mahalakshmi Netralaya - MariaDB Production Configuration

[mysqld]
# ===========================================
# Basic Settings
# ===========================================
server-id = 1
port = 3306
bind-address = 0.0.0.0
datadir = /var/lib/mysql
socket = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid

# ===========================================
# Character Set & Collation
# ===========================================
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init-connect = 'SET NAMES utf8mb4'

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

# ===========================================
# InnoDB Performance
# ===========================================
innodb_buffer_pool_size = 2G
innodb_buffer_pool_instances = 8
innodb_log_file_size = 512M
innodb_log_files_in_group = 2
innodb_log_buffer_size = 64M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_open_files = 4000
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_purge_threads = 4
innodb_page_cleaners = 4
innodb_adaptive_hash_index = ON
innodb_adaptive_hash_index_parts = 8

# ===========================================
# Connection Settings
# ===========================================
max_connections = 500
max_user_connections = 450
thread_cache_size = 100
thread_pool_size = 16
thread_pool_oversubscribe = 3
thread_handling = pool-of-threads

# Timeouts
wait_timeout = 300
interactive_timeout = 300
connect_timeout = 10
net_read_timeout = 300
net_write_timeout = 300

# ===========================================
# Query Cache (disabled - use Redis instead)
# ===========================================
query_cache_type = 0
query_cache_size = 0

# ===========================================
# Table & Sort Buffers
# ===========================================
table_open_cache = 4000
table_definition_cache = 2000
table_open_cache_instances = 16

sort_buffer_size = 4M
join_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 4M
tmp_table_size = 128M
max_heap_table_size = 128M

# ===========================================
# Binary Logging (for replication & PITR)
# ===========================================
log_bin = mysql-bin
binlog_format = ROW
binlog_row_image = MINIMAL
expire_logs_days = 7
max_binlog_size = 100M
binlog_cache_size = 4M
sync_binlog = 1

# GTID for replication
gtid_strict_mode = ON
enforce_gtid_consistency = ON
gtid_domain_id = 1

# ===========================================
# Slow Query Log
# ===========================================
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 1
log_slow_admin_statements = 1
log_slow_slave_statements = 1
min_examined_row_limit = 100

# ===========================================
# Error Log
# ===========================================
log_error = /var/log/mysql/error.log
log_warnings = 2

# ===========================================
# Security
# ===========================================
local_infile = 0
skip_show_database = 1
skip_name_resolve = 1

# ===========================================
# Performance Schema
# ===========================================
performance_schema = ON
performance_schema_instrument = '%wait/%=ON, %stage/%=ON, %statement/%=ON, %transaction/%=ON'

# ===========================================
# TLS/SSL
# ===========================================
ssl_ca = /etc/mysql/ssl/ca.pem
ssl_cert = /etc/mysql/ssl/server-cert.pem
ssl_key = /etc/mysql/ssl/server-key.pem
require_secure_transport = ON

# ===========================================
# Audit Plugin (optional - enable for compliance)
# ===========================================
# plugin_load_add = server_audit=server_audit.so
# server_audit_logging = ON
# server_audit_events = CONNECT,QUERY,TABLE
# server_audit_incl_users = root
# server_audit_file_path = /var/log/mysql/audit.log
# server_audit_file_rotate_size = 100M
# server_audit_file_rotations = 10

# ===========================================
# Backup & Recovery
# ===========================================
# For mariabackup
[xtrabackup]
compress = lz4
compress_threads = 4
encrypt = aes256
encrypt_key = ${BACKUP_ENCRYPTION_KEY}